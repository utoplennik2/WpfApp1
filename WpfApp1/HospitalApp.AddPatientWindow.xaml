<Window x:Class="HospitalApp.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Додати Пацієнта" Height="400" Width="400"
        Loaded="Window_Loaded">
    <Grid>
        <TextBlock Text="Прізвище:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,35,0,0"/>
        <TextBox Name="LastNameTextBox" HorizontalAlignment="Left" Margin="146,35,0,0" VerticalAlignment="Top" Width="200"/>

        <TextBlock Text="Ім'я:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,61,0,0"/>
        <TextBox Name="FirstNameTextBox" HorizontalAlignment="Left" Margin="146,63,0,0" VerticalAlignment="Top" Width="200"/>

        <TextBlock Text="Дата народження:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,96,0,0"/>
        <DatePicker Name="BirthDatePicker" HorizontalAlignment="Left" Margin="200,96,0,0" VerticalAlignment="Top" Width="146"/>

        <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,130,0,0"><Run Text="Дата "/><Run Language="uk-ua" Text="потрапляння"/><Run Text=":"/></TextBlock>
        <DatePicker Name="AdmissionDatePicker" HorizontalAlignment="Left" Margin="200,130,0,0" VerticalAlignment="Top" Width="146"/>

        <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,160,0,0"><Run Language="uk-ua" Text="Стать"/><Run Text=":"/></TextBlock>
        <ComboBox Name="GenderComboBox" HorizontalAlignment="Left" Margin="146,160,0,0" VerticalAlignment="Top" Width="200">
            <ComboBoxItem Content="Чоловічий"/>
            <ComboBoxItem Content="Жіночий"/>
        </ComboBox>

        <TextBlock Text="Період лікування (в днях):" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,190,0,0"/>
        <TextBox Name="TreatmentPeriodTextBox" HorizontalAlignment="Left" Margin="205,190,0,0" VerticalAlignment="Top" Width="141"/>

        <TextBlock Text="Доктор:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,220,0,0"/>
        <ComboBox Name="DoctorComboBox" HorizontalAlignment="Left" Margin="146,220,0,0" VerticalAlignment="Top" Width="200" IsEnabled="True">DisplayMemberPath="Content">
            <!-- Заповнюється автоматично -->
        </ComboBox>

        <Button Content="Додати" Name="AddButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="289,0,0,18" Click="AddButton_Click"/>
    </Grid>
</Window>
